{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=GenericIngestion;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;Connect Timeout=5"
  },
  "FileStorage": {
    "RootPath": "uploads"
  },
  "Application": {
    "Time": {
      "IndiaStandardTimeOffsetHours": 5.5
    },
    "Upload": {
      "MaxFileSizeBytes": 100000000,
      "ValidationExpiryMinutes": 30
    },
    "Notifications": {
      "UploadCompletedTitle": "Upload Completed",
      "UploadCompletedMessage": "The file has been uploaded successfully.",
      "NewCustomerUploadTitle": "New Customer Upload",
      "NewCustomerUploadMessage": "A new customer file has been uploaded.",
      "FileStateTitle": "File Status",
      "FileStateMessage": "The file status has been updated.",
      "CustomerFileStateTitle": "Customer File Status",
      "CustomerFileStateMessage": "The customer file status has been updated."
    }
  },
  "Jwt": {
    "Key": "",
    "ExpirationMinutes": 30
  },
    "Gemini": {
      "ApiKey": "",
    "Model": "gemini-flash-lite-latest"
    },
    "Serilog": {
      "MinimumLevel": "Information",
      "WriteTo": [
        {
          "Name": "Console"
        },
        {
          "Name": "File",
          "Args": {
            "path": "logs/application-.log",
            "rollingInterval": "Day",
            "retainedFileCountLimit": 30,
            "shared": true,
            "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
          }
        },
        {
          "Name": "File",
          "Args": {
            "path": "logs/errors-.log",
            "restrictedToMinimumLevel": "Error",
            "rollingInterval": "Day",
            "retainedFileCountLimit": 60,
            "shared": true,
            "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext} {Message:lj}{NewLine}{Exception}"
          }
        },
        {
          "Name": "MSSqlServer",
          "Args": {
            "connectionString": "Server=(localdb)\\MSSQLLocalDB;Database=GenericIngestion;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true;Connect Timeout=5",
            "tableName": "ApplicationLogs",
            "autoCreateSqlTable": true
          }
        }
      ]
    }
  }
